  "description": "Camera transforms, resize geometry and scene types for infinite canvases",
  "license": "MIT",
  "author": "ivanchik-byte",
  "homepage": "https://github.com/talweg-app/talweg/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talweg-app/talweg.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/talweg-app/talweg/issues",
  "keywords": ["canvas", "geometry", "camera", "diagram", "typescript"],
  "private": true,
  "type": "module",
